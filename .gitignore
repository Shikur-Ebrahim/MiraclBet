# ============================================================
# MiraclBet — .gitignore
# ============================================================

# Environment files — NEVER commit real secrets
.env
.env.local
.env.production
.env.staging
.env.*.local

# Allow example files
!.env.example

# ─── Node / Next.js ─────────────────────────────────────────
node_modules/
.next/
.vercel/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Go ─────────────────────────────────────────────────────
bin/
*.exe
*.test
*.out
coverage/
vendor/

# ─── IDE / OS ───────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/

# ─── Docker ─────────────────────────────────────────────────
.dockerignore
